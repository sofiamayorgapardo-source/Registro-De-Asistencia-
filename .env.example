# Configuración del servidor Flask
FLASK_ENV=development
PORT=5000
SECRET_KEY=cambiar_por_una_clave_secreta_segura_de_produccion

# Configuración de Base de Datos MySQL (Local XAMPP por defecto)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=asistec

